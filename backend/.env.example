# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite:///./petraslynn.db

# JWT
SECRET_KEY=change-this-to-a-random-secret-key

# Admin credentials (set ADMIN_PASSWORD to enable auto-seeding on startup)
ADMIN_EMAIL=petraslynn@proton.me
ADMIN_PASSWORD=change-this-password

# Email (Resend API)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Petraslynn LLC <onboarding@resend.dev>"

# Extra allowed frontend origins, comma-separated (the github.io URL and
# localhost dev servers are already allowed in main.py)
# CORS_ORIGINS=https://example.com,https://www.example.com

# Render (set automatically on Render, add for local dev if needed)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
